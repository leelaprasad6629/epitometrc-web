datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  contactNumber String?
  passwordHash  String
  role          String        @default("Student") // Student, Employee, Admin
  status        String        @default("Active")
  requirePasswordChange Boolean @default(false)
  createdAt     DateTime      @default(now())
  policyAccepted   Boolean   @default(false)
  policyAcceptedAt DateTime?
  policyVersion    String?   @default("v1.0")
  enrollments   Enrollment[]
  applications  Application[]
  profile       UserProfile?
  membership    UserMembership?
  assignmentSubmissions AssignmentSubmission[]
  quizAttempts          QuizAttempt[]
  discussionThreads     DiscussionThread[]
  discussionReplies     DiscussionReply[]
  courseCertificates    CourseCertificate[]
  lessonProgresses      LessonProgress[]
}

model UserProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  profile          Json?
  confidenceScores Json?
  resumeFile       Json?
  videoResumeFile  Json?
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id                 String           @id @default(uuid())
  title              String
  subtitle           String?
  slug               String?          @unique
  category           String
  description        String
  duration           String
  modules            Int
  image              String
  level              String           @default("Intermediate")
  language           String           @default("English")
  price              String           @default("Free")
  rating             Float            @default(4.8)
  reviewsCount       Int              @default(0)
  enrolledCount      Int              @default(0)
  learningObjectives Json?
  skillsCovered      Json?
  learningOutcomes   Json?
  prerequisites      Json?
  faqs               Json?
  instructorName     String?
  instructorRole     String?
  instructorAvatar   String?
  instructorBio      String?
  instructorLinkedIn String?
  enrollments        Enrollment[]
  schedules          CohortSchedule[]
  materials          CohortMaterial[]
  courseModules      CourseModule[]
  courseResources    CourseResource[]
  discussionThreads  DiscussionThread[]
  certificates       CourseCertificate[]
}

model Enrollment {
  id          String   @id @default(uuid())
  userId      String
  courseId    String
  progress    Int      @default(0)
  completedAt DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendances Attendance[]
}

model Job {
  id           String        @id @default(uuid())
  title        String
  category     String
  location     String
  type         String
  description  String
  status       String        @default("Active")
  applications Application[]
}

model Application {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  status    String   @default("Reviewing") // Reviewing, Interviewing, Approved, Rejected
  appliedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Enquiry {
  id         String   @id @default(uuid())
  name       String
  email      String
  subject    String
  message    String
  status     String   @default("Pending") // Pending, In Progress, Completed
  receivedAt DateTime @default(now())
}

model Attendance {
  id           String   @id @default(uuid())
  enrollmentId String
  status       String   @default("Present") // Present, Absent
  date         String   // "YYYY-MM-DD"
  updatedAt    DateTime @updatedAt
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model Lead {
  id                    String   @id @default(uuid())
  name                  String
  email                 String
  requirements          String
  leadScore             Int      @default(0)
  priority              String   @default("Warm") // Hot, Warm, Cold
  industry              String?
  companySize           String?
  businessNeed          String?
  conversionProbability Int      @default(0)
  explanation           String?
  painPoints            String?  // JSON string
  opportunities         String?  // JSON string
  risks                 String?  // JSON string
  recommendedServices   String?  // JSON string
  recommendedNextAction String?
  status                String   @default("Qualified") // Qualified, Disqualified, Override
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Proposal {
  id                 String   @id @default(uuid())
  clientName         String
  requirements       String
  companyOverview    String
  projectScope       String
  services           String   // JSON string
  timeline           String   // JSON string
  deliverables       String   // JSON string
  totalPrice         String
  priceBreakdown     String   // JSON string
  termsAndConditions String
  status             String   @default("Draft") // Draft, Sent, Accepted, Rejected
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CRMClient {
  id                 String   @id @default(uuid())
  name               String
  email              String
  company            String
  status             String   @default("Lead")
  health             String   @default("Active") // Active, Inactive
  summary            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  interactions       CRMInteraction[]
  actionItems        CRMActionItem[]
}

model CRMInteraction {
  id          String   @id @default(uuid())
  clientId    String
  date        String
  type        String   // Email, Meeting, Call, Ticket
  description String
  participant String
  createdAt   DateTime @default(now())
  client      CRMClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model CRMActionItem {
  id          String   @id @default(uuid())
  clientId    String
  description String
  priority    String   // High, Medium, Low
  status      String   @default("Pending") // Pending, Completed
  createdAt   DateTime @default(now())
  client      CRMClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model RecordVersion {
  id            String   @id @default(uuid())
  recordId      String
  recordType    String   // Proposal, Lead, CRMClient, Job, Course, Attendance
  version       String   // v1.0, v1.1, etc.
  createdAt     DateTime @default(now())
  userId        String?
  changeSummary String
  snapshot      String   // Full JSON snapshot
}

model CohortSchedule {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  date      String   // "YYYY-MM-DD"
  time      String   // e.g., "14:00 - 15:30"
  link      String?  // Optional video meeting link
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CohortMaterial {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  type      String   // "PDF", "Video", "Link", etc.
  url       String   // Document download URL
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model ChatLog {
  id                 String   @id @default(uuid())
  userId             String?
  name               String?
  email              String?
  phone              String?
  messages           Json
  escalated          Boolean  @default(false)
  escalationReason   String?
  assignedDepartment String?
  assignedMentor     String?
  browser            String?
  device             String?
  os                 String?
  ipAddress          String?
  outcome            String   @default("Active")
  status             String   @default("Pending")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ChatSession {
  id                  String   @id @default(uuid())
  sessionId           String   @unique
  userId              String?
  startTime           DateTime @default(now())
  endTime             DateTime?
  conversationStatus  String   @default("Active") // Active, Escalated, Resolved, Abandoned
  resolved            Boolean  @default(false)
  escalated           Boolean  @default(false)
  department          String?
  conversationSummary String?
  confidenceScore     Float?
  device              String?
  browser             String?
  operatingSystem     String?
  language            String?
  referrerUrl         String?
  currentPage         String?
  ipAddress           String?  // Hashed IP
  country             String?
  state               String?
  city                String?
  latitude            Float?
  longitude           Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  messages            ChatMessage[]
  escalation          ChatEscalation?
}

model ChatMessage {
  id           String      @id @default(uuid())
  sessionId    String
  sender       String      // "user" | "bot"
  message      String
  timestamp    DateTime    @default(now())
  intent       String?
  confidence   Float?
  tokensUsed   Int?
  responseTime Int?        // milliseconds
  session      ChatSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
}

model ChatEscalation {
  id                  String      @id @default(uuid())
  sessionId           String      @unique
  userName            String
  email               String
  phone               String?
  assignedDepartment  String
  routingReason       String?
  conversationSummary String?
  status              String      @default("Pending") // Pending, Assigned, Resolved, Closed
  assignedTo          String?
  resolutionNotes     String?
  resolvedAt          DateTime?
  createdAt           DateTime    @default(now())
  session             ChatSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  userEmail String
  action    String   // "CREATE_USER", "UPDATE_USER", "DELETE_USER", "UPDATE_SETTINGS", etc.
  details   String   // JSON string of details
  ipAddress String?
  createdAt DateTime @default(now())
}

model UserMembership {
  id                    String    @id @default(uuid())
  userId                String    @unique
  planName              String    @default("Free Plan")
  status                String    @default("Active") // Active, Expired, Suspended
  validUntil            DateTime?
  mockInterviewsUsed    Int       @default(0)
  resumesOptimizedUsed  Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  orderIndex  Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
}

model Lesson {
  id                String             @id @default(uuid())
  moduleId          String
  title             String
  description       String?
  duration          String
  orderIndex        Int
  type              String             @default("video") // video, notes, quiz, assignment
  videoUrl          String?
  notesContent      String?
  isFreePreview     Boolean            @default(false)
  module            CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignments       Assignment[]
  quizzes           Quiz[]
  resources         CourseResource[]
  progresses        LessonProgress[]
  discussionThreads DiscussionThread[]
}

model Assignment {
  id           String                 @id @default(uuid())
  lessonId     String
  title        String
  instructions String
  deadline     String?
  maxMarks     Int                    @default(100)
  lesson       Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions  AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  userId       String
  fileUrl      String?
  textResponse String?
  marks        Int?
  status       String     @default("Submitted") // Submitted, Graded, Resubmit
  feedback     String?
  submittedAt  DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Quiz {
  id               String         @id @default(uuid())
  lessonId         String
  title            String
  passingScore     Int            @default(70)
  timeLimitMinutes Int            @default(15)
  lesson           Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions        QuizQuestion[]
  attempts         QuizAttempt[]
}

model QuizQuestion {
  id            String   @id @default(uuid())
  quizId        String
  questionText  String
  questionType  String   @default("mcq") // mcq, tf, short
  options       Json
  correctAnswer String
  explanation   String?
  points        Int      @default(10)
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String
  userId      String
  score       Float
  passed      Boolean
  answers     Json
  attemptedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CourseResource {
  id       String  @id @default(uuid())
  courseId String
  lessonId String?
  title    String
  fileType String // PDF, ZIP, PPT, Code
  fileUrl  String
  fileSize String?
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model DiscussionThread {
  id        String            @id @default(uuid())
  courseId  String
  lessonId  String?
  authorId  String
  title     String
  content   String
  isSolved  Boolean           @default(false)
  createdAt DateTime          @default(now())
  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   DiscussionReply[]
}

model DiscussionReply {
  id                String           @id @default(uuid())
  threadId          String
  authorId          String
  content           String
  isInstructorReply Boolean          @default(false)
  createdAt         DateTime         @default(now())
  thread            DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author            User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model CourseCertificate {
  id                String   @id @default(uuid())
  certificateId     String   @unique
  courseId          String
  userId            String
  issuedAt          DateTime @default(now())
  qrVerificationUrl String?
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  id                  String    @id @default(uuid())
  userId              String
  lessonId            String
  watchTimeSeconds    Int       @default(0)
  isCompleted         Boolean   @default(false)
  lastPositionSeconds Int       @default(0)
  completedAt         DateTime?
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

