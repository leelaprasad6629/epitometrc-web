{
  "expo": {
    "name": "EpitomeTRC",
    "slug": "epitometrc-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "epitometrc",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/fafb2817-d629-428c-b217-e2f710c8d788",
      "enabled": true,
      "checkAutomatically": "NEVER"
    },
    "runtimeVersion": "1.0.0",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.epitometrc.app"
    },
    "android": {
      "package": "com.epitometrc.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fafb2817-d629-428c-b217-e2f710c8d788"
      }
    },
    "owner": "lalitha_sreya"
  }
}
